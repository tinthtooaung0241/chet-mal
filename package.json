{
  "name": "kitchen-coop",
  "private": true,
  "scripts": {
    "dev:client": "pnpm --filter ./client run dev",
    "dev:server": "pnpm --filter ./server run dev",
    "build": "pnpm --filter ./client run build && pnpm --filter ./server run build",
    "start": "pnpm --filter ./server run start",
    "typecheck": "pnpm --filter ./client run typecheck && pnpm --filter ./server run typecheck",
    "start:prod": "pnpm --filter ./server run start:prod",
    "test:coach": "tsx shared/test/autoplay.ts",
    "test:recipes": "tsx shared/test/recipes.ts",
    "test:burmese": "tsx client/test/burmese.ts",
    "test:rules": "tsx shared/test/rules.ts"
  },
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "tsx": "4.23.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
