{
  "name": "kitchen-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --sourcemap --outfile=dist/index.js --packages=external --alias:@kitchen/shared=../shared/src/index.ts",
    "start:prod": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kitchen/shared": "*",
    "@sentry/node": "^11.11.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
